{
  "info": {
    "name": "ShopLite API",
    "description": "Smoke + regression checks for the ShopLite REST API. Run with Newman: see postman/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:5000" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/health" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status 200', () => pm.response.to.have.status(200));",
        "pm.test('body ok', () => pm.expect(pm.response.json().status).to.eql('ok'));",
        "pm.test('responds under 500ms', () => pm.expect(pm.response.responseTime).to.be.below(500));"
      ]}}]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Token - bad password",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/auth/token",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\": \"{{username}}\", \"password\": \"wrong\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 401', () => pm.response.to.have.status(401));",
            "pm.test('error message', () => pm.expect(pm.response.json().error).to.eql('Invalid username or password'));"
          ]}}]
        },
        {
          "name": "Token - valid",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/auth/token",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\": \"{{username}}\", \"password\": \"{{password}}\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('bearer token issued', () => {",
            "  pm.expect(body.token_type).to.eql('Bearer');",
            "  pm.expect(body.token).to.be.a('string').and.have.length.above(20);",
            "});",
            "pm.collectionVariables.set('token', body.token);"
          ]}}]
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/products" },
          "event": [{ "listen": "test", "script": { "exec": [
            "const schema = {",
            "  type: 'object', required: ['count', 'items'],",
            "  properties: { items: { type: 'array', items: { type: 'object',",
            "    required: ['id', 'sku', 'name', 'category', 'price_cents', 'stock', 'in_stock'] } } }",
            "};",
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('matches schema', () => pm.response.to.have.jsonSchema(schema));",
            "pm.test('count matches items', () => {",
            "  const b = pm.response.json();",
            "  pm.expect(b.count).to.eql(b.items.length);",
            "});"
          ]}}]
        },
        {
          "name": "Filter by category",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/products?category=Books", "host": ["{{baseUrl}}"], "path": ["api", "products"],
                     "query": [{ "key": "category", "value": "Books" }] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('only books returned', () => {",
            "  const items = pm.response.json().items;",
            "  pm.expect(items.length).to.be.above(0);",
            "  items.forEach(p => pm.expect(p.category).to.eql('Books'));",
            "});"
          ]}}]
        },
        {
          "name": "Unknown product",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/products/99999" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 404', () => pm.response.to.have.status(404));",
            "pm.test('JSON error body', () => pm.expect(pm.response.json()).to.have.property('error'));"
          ]}}]
        }
      ]
    },
    {
      "name": "Cart & orders",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
      "item": [
        {
          "name": "Clear cart item (setup)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/cart/2" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('204 or 404', () => pm.expect(pm.response.code).to.be.oneOf([204, 404]));"
          ]}}]
        },
        {
          "name": "Add to cart - invalid quantity",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/cart",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"product_id\": 2, \"quantity\": -1}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 422 (BUG-003 regression)', () => pm.response.to.have.status(422));"
          ]}}]
        },
        {
          "name": "Add to cart",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/cart",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"product_id\": 2, \"quantity\": 2}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 201', () => pm.response.to.have.status(201));",
            "const cart = pm.response.json();",
            "const line = cart.items.find(i => i.product_id === 2);",
            "pm.test('line total = qty x price', () => pm.expect(line.line_total_cents).to.eql(line.quantity * line.unit_price_cents));",
            "pm.test('tax is 8% rounded', () => pm.expect(cart.tax_cents).to.eql(Math.round(cart.subtotal_cents * 0.08)));"
          ]}}]
        },
        {
          "name": "Place order",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/orders",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"full_name\": \"Newman Runner\", \"email\": \"newman@example.com\", \"address\": \"1 CI Street\", \"zip_code\": \"80202\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 201', () => pm.response.to.have.status(201));",
            "const order = pm.response.json();",
            "pm.test('total = subtotal + tax', () => pm.expect(order.total_cents).to.eql(order.subtotal_cents + order.tax_cents));",
            "pm.test('status PLACED', () => pm.expect(order.status).to.eql('PLACED'));",
            "pm.collectionVariables.set('orderId', order.id);"
          ]}}]
        },
        {
          "name": "Get order",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/orders/{{orderId}}" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('same order id', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('orderId'))));"
          ]}}]
        },
        {
          "name": "Cart empty after order",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/cart" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('cart cleared', () => pm.expect(pm.response.json().items).to.be.empty);"
          ]}}]
        }
      ]
    }
  ]
}
